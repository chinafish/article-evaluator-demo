# 服务器配置
PORT=3000

# AI配置（火山引擎 Kimi）
AI_PROVIDER=kimi
AI_API_KEY=your_kimi_api_key_here
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=kimi-k2-250905

# 通义千问配置（阿里云）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL_FLASH=qwen3.5-flash
DASHSCOPE_MODEL_PLUS=qwen3.5-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型路由配置
MODEL_ROUTING_ENABLED=true
MODEL_FOR_CLASSIFICATION=qwenFlash
MODEL_FOR_EVALUATION=qwenPlus
MODEL_FOR_REPORT_GENERATION=qwenPlus
MODEL_FOR_BENCHMARK_GENERATION=qwenPlus

# 路由配置
ROUTING_CONFIDENCE_THRESHOLD=0.7
ROUTING_MIN_CONTENT_LENGTH=100
