# 服务器配置
PORT=3000

# AI配置（选择其一）
AI_PROVIDER=openai  # openai | qwen | wenxin
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# 路由模型配置（可选，用于降低路由成本）
# 如果不配置，默认使用 AI_MODEL
ROUTING_MODEL=gpt-3.5-turbo

# 路由配置
ROUTING_CONFIDENCE_THRESHOLD=0.7  # 路由置信度阈值（0.0-1.0）
ROUTING_MIN_CONTENT_LENGTH=100     # 最小内容长度（字数）
